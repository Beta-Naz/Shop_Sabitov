@using Shop.Data.Models
@model IEnumerable<Category>

@{
    Layout = "_Layout";
    ViewBag.Title = "Список категорий";
}

<h2>Все категории</h2>

<a href="/Category/Add" class="add-btn">Добавить категорию</a>

@foreach (var category in Model)
{
    <div class="item">
        <div class="dataCat">
            <h3>Название: @category.Name</h3>
            <div>Описание: @category.Description</div>
            <div class="actions">
                <a href="/Category/Update/@category.Id" class="edit-btn">Редактировать</a>
                <a href="/Category/Delete/@category.Id" class="delete-btn" onclick="return confirm('Удалить категорию?')">Удалить</a>
            </div>
        </div>
    </div>
}