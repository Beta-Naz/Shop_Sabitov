@using Shop.Data.Models
@using Shop.Data.ViewModell
@model VMUpdateItem

@{
    Layout = "_Layout";
    ViewBag.Title = "Редактирование товара";
}

<h2>Редактирование товара</h2>

<form method="post" action="/Item/Update">
    <input type="hidden" name="id" value="@Model.Item.Id" />

    <div>
        Наименование:
        <br /> <input name="name" value="@Model.Item.Name" required />
    </div>
    <div>
        Описание:
        <br /> <textarea name="description">@Model.Item.Description</textarea>
    </div>
    <div>
        Стоимость:
        <br /> <input name="price" type="number" step="1" value="@Model.Item.Price" required />
    </div>
    <div>
        Категория:
        <br /> <select name="idCategory">
            @foreach (var category in Model.Categories)
            {
                if (category.Id == Model.Item.Category.Id)
                {
                    <option selected="selected" value="@category.Id">@category.Name</option>
                }
                else
                {
                    <option value="@category.Id">@category.Name</option>
                }
            }
        </select>
    </div>
    <input type="submit" value="Сохранить" />
    <a href="/Item/List">Отмена</a>
</form>